{
  "expo": {
    "name": "VendasApp",
    "slug": "vendasapp-ios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "vendasapp",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9FAFB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dgppropaganda.vendasapp",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "O app precisa de acesso à câmera para fotografar a logo da empresa.",
        "NSPhotoLibraryUsageDescription": "O app precisa de acesso à galeria para adicionar a logo da empresa."
      },
      "usesAppleSignIn": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.dgppropaganda.vendasapp",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa de acesso à sua galeria para adicionar a logo da empresa.",
          "cameraPermission": "O app precisa de acesso à câmera para fotografar a logo da empresa."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1deea491-f4f8-4108-be47-02d9e5e01ff7"
      }
    }
  }
}
